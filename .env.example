# Copiá este archivo a .env y completalo. .env no se sube a git.

PORT=3000

# Panel del mostrador (usuario y clave de acceso). Si no definís la clave,
# se genera una al azar en cada arranque y se imprime en la consola.
PANEL_USER=farmacia
PANEL_PASSWORD=

# Token para que n8n / Claude llamen a /agent (mínimo 24 caracteres; sin esto la API está apagada).
# Generá uno con: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AGENT_API_TOKEN=

# Claude dentro del bot (POST /agent/respond). Sin esta clave, ese endpoint queda apagado.
ANTHROPIC_API_KEY=
# Modelo y esfuerzo (low | medium | high | xhigh | max). Si dejás el esfuerzo vacío se usa el del modelo.
# Para bajar costo y latencia podés probar claude-sonnet-5-5 o claude-haiku-5-5.
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_EFFORT=

# Catálogo de productos de demostración (se arma con: npm run catalog:scrape).
# CATALOG_DB=./data/catalog.db

# Días que se conservan mensajes, recetas y pedidos cerrados antes de borrarlos.
RETENTION_DAYS=90

# Simulador de chat en /sim. Por defecto está activo solo si WhatsApp NO está configurado.
# No lo actives en un servidor público.
# ENABLE_SIMULATOR=1

# --- WhatsApp Cloud API (Meta). Dejar vacío para trabajar solo con el simulador. ---
WA_ACCESS_TOKEN=
WA_PHONE_NUMBER_ID=
# Texto cualquiera; el mismo que cargues en la configuración del webhook en Meta.
WA_VERIFY_TOKEN=
# "App secret" de la app de Meta: se usa para validar la firma de cada webhook.
WA_APP_SECRET=
WA_API_VERSION=v23.0
# Plantilla aprobada para los recordatorios (mensajes que inicia la farmacia).
# Variables: {{1}} medicamento, {{2}} nombre de la farmacia.
WA_REMINDER_TEMPLATE=
WA_TEMPLATE_LANG=es_AR
